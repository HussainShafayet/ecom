# Base URL of the backend REST API (see CLAUDE.md). Copy this file to .env and fill in a real value.
VITE_BASE_URL=

# Optional error tracking (Sentry). Empty = off (local dev, tests, CI). Set it on a deployed build to report
# uncaught render errors and server (5xx)/network errors from the API clients.
VITE_SENTRY_DSN=
